<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:elevation="@dimen/xs">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="@dimen/m"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/items"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />

                <!-- Toggle Buttons for Mode Switch -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/m"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnItems"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="120dp"
                        android:layout_height="40dp"
                        android:text="@string/items"
                        android:textSize="@dimen/tx_s"
                        android:textColor="@color/toggle_button_text_color"
                        app:backgroundTint="@color/toggle_button_background_color"
                        app:strokeColor="?attr/colorOutline"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCategories"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="120dp"
                        android:layout_height="40dp"
                        android:text="@string/categories"
                        android:textSize="@dimen/tx_s"
                        android:textColor="@color/toggle_button_text_color"
                        app:backgroundTint="@color/toggle_button_background_color"
                        app:strokeColor="?attr/colorOutline"
                        app:strokeWidth="1dp" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Search + Sort + Cart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/xs">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_search"
                android:drawableTint="?attr/colorOnSurface"
                android:drawablePadding="@dimen/xs"
                android:hint="@string/search"
                android:padding="@dimen/xs" />

            <!-- Sort -->
            <ImageButton
                android:id="@+id/ibSort"
                android:layout_width="@dimen/xxxl"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/xs"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorOnSurface"
                android:padding="@dimen/xxs"
                android:src="@drawable/ic_sort" />

            <!-- Cart with Badge -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/xxs">

                <ImageButton
                    android:id="@+id/ibCart"
                    android:layout_width="@dimen/xxxl"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="?attr/colorOnSurface"
                    android:padding="@dimen/xxs"
                    android:src="@drawable/ic_cart" />

                <TextView
                    android:id="@+id/tvCartBadge"
                    android:layout_width="@dimen/xl"
                    android:layout_height="@dimen/xl"
                    android:layout_gravity="end|top"
                    android:background="@drawable/badge_background"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="@dimen/tx_xs"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

        <!-- Content -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvItems"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/xs"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/xxxxl" />

            <LinearLayout
                android:id="@+id/llEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/xl">

                <ImageView
                    android:layout_width="@dimen/xxxxxl"
                    android:layout_height="@dimen/xxxxxl"
                    android:layout_marginBottom="@dimen/m"
                    app:tint="?attr/colorOnSurface"
                    android:src="@drawable/ic_question" />

                <TextView
                    android:id="@+id/tvEmpty"
                    style="@style/TextAppearance.Material3.TitleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_item"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvEmptyHint"
                    style="@style/TextAppearance.Material3.BodyLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_hint"
                    android:textAlignment="center"
                    android:layout_marginTop="@dimen/xs"
                    android:layout_marginBottom="@dimen/xl" />

            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- FAB Add -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="@dimen/xl"
        android:layout_marginBottom="@dimen/xxl"
        android:backgroundTint="@color/blue"
        android:text="@string/add_new"
        android:textColor="@color/white"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/white" />

</FrameLayout>
