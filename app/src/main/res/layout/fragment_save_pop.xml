<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/xxl"
    tools:context=".ui.popup.SavePopFragment">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="@dimen/xxl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/select_table"
                android:textSize="@dimen/tx_xxxl"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:padding="@dimen/xs"/>

            <!-- Table Selection Grid -->
            <GridLayout
                android:id="@+id/gridTables"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="2"
                android:layout_marginTop="@dimen/m"
                android:layout_marginBottom="@dimen/m">

                <!-- Tables 1-6 will be added programmatically -->

            </GridLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/or_custom_name"
                android:textSize="@dimen/tx_m"
                android:gravity="center"
                android:layout_marginTop="@dimen/m"
                android:layout_marginBottom="@dimen/xs"/>

            <EditText
                android:id="@+id/etTicketName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/m"
                android:hint="@string/enter_ticket_name"
                android:textColor="@color/black"
                android:inputType="text"
                android:maxLines="1"
                android:layout_marginBottom="@dimen/m"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mbSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save"
                android:textSize="@dimen/tx_xl"
                android:textColor="@color/white"
                app:cornerRadius="@dimen/m"
                android:paddingVertical="@dimen/m"
                app:backgroundTint="@color/blue"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
