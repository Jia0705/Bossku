<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvItem"
    android:layout_width="match_parent"
    android:layout_height="@dimen/xxxxxxl"
    android:layout_margin="@dimen/xs"
    app:cardCornerRadius="@dimen/s"
    app:cardElevation="@dimen/s">

    <LinearLayout
        android:id="@+id/llItem"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/xs"
        android:gravity="center">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/name"
            android:textSize="@dimen/tx_xl"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="RM 0.00"
            android:textSize="@dimen/tx_l"
            android:textColor="@color/black"
            android:layout_marginTop="@dimen/xxs" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
